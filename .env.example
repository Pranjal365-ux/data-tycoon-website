# Copy to .env for local runs (python server.py). On Vercel/Azure set these in the
# project's environment settings instead. Never commit real values.

# Organizer password and a different long random secret used to sign sessions.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Secret URL path of the organizer console (16+ letters, digits, - or _).
# The console is then at https://<your-domain>/<ADMIN_CONSOLE_PATH>/ and is
# disabled (404) when this is unset. Generate one with:
#   python -c "import secrets; print('ops-' + secrets.token_urlsafe(18))"
ADMIN_CONSOLE_PATH=ops-replace-with-a-random-value

# Optional: only allow the console from these IPs / CIDR ranges (comma separated).
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# MongoDB connection (Atlas, Azure Cosmos DB for MongoDB vCore, or local Docker).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=data_tycoon

# Local server only.
HOST=127.0.0.1
PORT=8000
