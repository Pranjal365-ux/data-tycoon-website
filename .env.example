# Copy this file to .env and replace both values with long random strings.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret

# Required on Vercel for shared team and activity data. Use a PostgreSQL URL
# from Vercel Storage/Neon (the API also accepts POSTGRES_URL).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: set an exact comma-separated origin allowlist when deploying.
# ALLOWED_ORIGIN=https://your-event-site.example
HOST=127.0.0.1
PORT=8000
